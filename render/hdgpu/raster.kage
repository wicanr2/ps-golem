//kage:unit pixels
package main

var Origin vec2
var ColorLo, ColorHi, DXLo, DXHi, DYLo, DYHi vec3
var Mode, Textured, Modulate, Dither, Sprite, Scale, MaskSet, MaskEval float

// 16 位元拆開累加，避免 float 尾數損失或 signed int32 乘法溢位。
// x<8192、y<4096，每個乘積及累加均小於 2^31。
func colorAt(lo, hi, dxlo, dxhi, dylo, dyhi, x, y int) int {
	l := lo + dxlo*x + dylo*y
	h := hi + dxhi*x + dyhi*y + (l>>16)
	return (h>>8)&255
}
func word(c vec4) int { return int(c.r*255+0.5) | (int(c.g*255+0.5)<<8) }
func packed(w int) vec4 { return vec4(float(w&255)/255,float((w>>8)&255)/255,0,1) }
func mixWord(mode,bg,fore int) int {
	if mode==0 { b:=bg|32768; return (((fore+b)-((fore^b)&1057))>>1)&65535 }
	if mode==1 { b:=bg&32767; s:=fore+b; c:=(s-((fore^b)&33825))&33824; return ((s-c)|(c-(c>>5)))&65535 }
	if mode==2 { b:=bg|32768; f:=fore&32767; d:=b-f+1082400; c:=(d-((b^f)&1082400))&1082400;return ((d-c)&(c-(c>>5)))&65535 }
	if mode==3 { b:=bg&32767; f:=((fore>>2)&7399)|32768; s:=f+b; c:=(s-((f^b)&33825))&33824; return ((s-c)|(c-(c>>5)))&65535 }
	return fore
}
func ditherAt(x,y int) int {
	a := [16]int{-4,0,-3,1,2,-2,3,-1,-3,1,-4,0,3,-1,2,-2}
	return a[(y&3)*4+(x&3)]
}
func Fragment(pos vec4,uv vec2) vec4 {
	src:=imageSrc0At(uv)
	originalBg:=imageSrc1At(uv)
	if src.a<0.5 { return originalBg }
	bgc:=originalBg
	if Sprite>0.5 && src.b<0.5 {
		local:=uv-imageSrc0Origin()
		bgc=imageSrc1At(uv-vec2(float(int(local.x)%int(Scale)),float(int(local.y)%int(Scale))))
	}
	bg:=word(bgc)
	if bg&int(MaskEval)!=0 { return originalBg }
	x,y:=int(pos.x)+int(Origin.x),int(pos.y)+int(Origin.y)
	r:=colorAt(int(ColorLo.r),int(ColorHi.r),int(DXLo.r),int(DXHi.r),int(DYLo.r),int(DYHi.r),x,y)
	g:=colorAt(int(ColorLo.g),int(ColorHi.g),int(DXLo.g),int(DXHi.g),int(DYLo.g),int(DYHi.g),x,y)
	b:=colorAt(int(ColorLo.b),int(ColorHi.b),int(DXLo.b),int(DXHi.b),int(DYLo.b),int(DYHi.b),x,y)
	fore:=word(src)
	if Textured>0.5 {
		if Modulate>0.5 {
			d:=0
			if Dither>0.5 { d=ditherAt(x/int(Scale),y/int(Scale)) }
			r=clamp(((fore&31)*r>>4)+d,0,255)>>3
			g=clamp((((fore>>5)&31)*g>>4)+d,0,255)>>3
			b=clamp((((fore>>10)&31)*b>>4)+d,0,255)>>3
			fore=(fore&32768)|r|(g<<5)|(b<<10)
		}
	} else {
		d:=0
		if Dither>0.5 { d=ditherAt(x/int(Scale),y/int(Scale)) }
		r=clamp(r+d,0,255)>>3; g=clamp(g+d,0,255)>>3; b=clamp(b+d,0,255)>>3
		fore=32768|r|(g<<5)|(b<<10)
	}
	if Mode>=0 && fore&32768!=0 { fore=mixWord(int(Mode),bg,fore) }
	if Textured<0.5 { fore=fore&32767 }
	return packed(fore|int(MaskSet))
}
